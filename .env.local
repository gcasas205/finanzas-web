# ═══════════════════════════════════════════════════════════
# AUTENTICACIÓN (Google OAuth)
# ═══════════════════════════════════════════════════════════
#
# 1. Ir a https://console.cloud.google.com/apis/credentials
# 2. Crear un "OAuth 2.0 Client ID" de tipo "Web application"
# 3. En "Authorized redirect URIs" agregar:
#    - http://localhost:3000/api/auth/callback/google (desarrollo)
#    - https://tu-dominio.com/api/auth/callback/google (producción)
# 4. Copiar Client ID y Client Secret acá:

GOOGLE_CLIENT_ID=337054857187-ivc41sdcd06qk7efibnn6lkt5t5bc61o.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# ═══════════════════════════════════════════════════════════
# SECRETO DE SESIÓN
# ═══════════════════════════════════════════════════════════
# Generá uno con: openssl rand -base64 32
NEXTAUTH_SECRET=TDGE3xMiOsMmoKWuAQe3DfKATIV1g2ql4r+H0vdwvgk=

# URL base de la app (cambiar en producción)
NEXTAUTH_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════
# WHITELIST DE EMAILS
# ═══════════════════════════════════════════════════════════
# Solo estas cuentas de Google pueden iniciar sesión.
# Separar con comas, sin espacios.
# Si se deja vacío, CUALQUIER cuenta de Google puede entrar.
ALLOWED_EMAILS=gonzaloacasas@gmail.com
