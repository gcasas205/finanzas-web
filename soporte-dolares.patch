+                      {op.tipo === "compra" ? "↓ Compra" : "↑ Venta"}
+                    </span>
+                  </td>
+                  <td className="px-2 py-4 text-right tabular font-mono text-sm text-paper">
+                    {formatUSD(op.montoUSD)}
