# ═══════════════════════════════════════════════════════════
# AUTENTICACIÓN (Google OAuth - NextAuth)
# ═══════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu-client-secret

# Generá con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=tu-secreto-aleatorio

# URL de la app (en Vercel se autodetecta, pero mejor explicitarlo)
NEXTAUTH_URL=https://tu-app.vercel.app

# Emails permitidos (separados por coma). Solo estas cuentas pueden entrar.
ALLOWED_EMAILS=tu-email@gmail.com

# ═══════════════════════════════════════════════════════════
# GOOGLE SHEETS (base de datos)
# ═══════════════════════════════════════════════════════════
# ID de tu planilla (de la URL: docs.google.com/spreadsheets/d/[ESTE_ID]/edit)
GOOGLE_SHEET_ID=1s6EHLBbs8C_3baM-xd7oNnj3PpgG4oFafCTpe_7xd-s

# Credenciales de la cuenta de servicio como JSON.
# Copiá TODO el contenido del .json y pegalo acá en una sola línea.
# En Vercel: Settings → Environment Variables → pegá el JSON completo.
GOOGLE_SHEETS_CREDS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ═══════════════════════════════════════════════════════════
# APP CONFIG (opcionales, se pueden cambiar desde Ajustes)
# ═══════════════════════════════════════════════════════════
APP_NOMBRE=Gonzalo Casas
MP_TNA=27.0
CARD_CUTOFF_DAY=23
CARD_DUE_DAY=5
